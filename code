```cpp
int ldr = A0;
int led = 9;

void setup() {

  pinMode(led, OUTPUT);
  Serial.begin(9600);
}

void loop() {

  int value = analogRead(ldr);

  Serial.println(value);

  // Dark room
  if(value < 500) {

    analogWrite(led, 255);
  }

  // Bright room
  else {

    analogWrite(led, 80);
  }

  delay(500);
}
```
